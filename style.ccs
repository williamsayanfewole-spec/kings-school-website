* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
  }

html {
scroll-behavior: smooth;
}

body {
font-family: Arial, Helvetica, sans-serif;
color: #172033;
background: #ffffff;
line-height: 1.6;
}

a {
text-decoration: none;
color: inherit;
}

button,
input,
textarea,
select {
font-family: inherit;
}

.container {
width: 90%;
max-width: 1200px;
margin: auto;
}

/* ================= HEADER ================= */

.header {
position: sticky;
top: 0;
z-index: 1000;
background: #ffffff;
border-bottom: 1px solid #eeeeee;
}

.nav-container {
min-height: 80px;
display: flex;
align-items: center;
justify-content: space-between;
}

.logo {
display: flex;
align-items: center;
gap: 10px;
color: #0b2559;
}

.logo-symbol {
color: #c79b32;
font-size: 38px;
}

.logo-text strong {
display: block;
font-size: 20px;
}

.logo-text small {
display: block;
color: #777777;
font-size: 11px;
}

.navbar {
display: flex;
align-items: center;
gap: 24px;
}

.navbar a {
font-size: 14px;
font-weight: 600;
transition: 0.3s;
}

.navbar a:hover {
color: #c79b32;
}

.nav-apply {
background: #0b2559;
color: white !important;
padding: 12px 20px;
border-radius: 5px;
}

.nav-apply:hover {
background: #c79b32;
}

.menu-button {
display: none;
background: none;
border: none;
font-size: 30px;
cursor: pointer;
color: #0b2559;
}

/* ================= HERO ================= */

.hero {
min-height: 650px;
position: relative;

```
background:
    linear-gradient(
        rgba(5, 24, 56, 0.78),
        rgba(5, 24, 56, 0.78)
    ),
    url("https://images.unsplash.com/photo-1580582932707-520aed937b7b?auto=format&fit=crop&w=1800&q=80");

background-size: cover;
background-position: center;

display: flex;
align-items: center;
```

}

.hero-content {
position: relative;
z-index: 2;
color: white;
padding: 100px 0;
}

.eyebrow,
.section-label {
color: #c79b32;
font-size: 13px;
font-weight: bold;
letter-spacing: 2px;
margin-bottom: 12px;
}

.hero h1 {
max-width: 850px;
font-size: clamp(42px, 6vw, 76px);
line-height: 1.05;
margin-bottom: 20px;
}

.hero h1 span {
color: #e0b94f;
}

.location {
font-size: 20px;
margin-bottom: 12px;
}

.hero-description {
max-width: 650px;
color: #eeeeee;
font-size: 18px;
margin-bottom: 30px;
}

.hero-buttons {
display: flex;
gap: 15px;
flex-wrap: wrap;
}

/* ================= BUTTONS ================= */

.button {
display: inline-block;
padding: 14px 24px;
border-radius: 5px;
border: 2px solid transparent;
font-weight: bold;
cursor: pointer;
transition: 0.3s;
}

.button-gold {
background: #c79b32;
color: white;
}

.button-gold:hover {
background: #a77e21;
}

.button-outline {
border-color: white;
color: white;
}

.button-outline:hover {
background: white;
color: #0b2559;
}

.button-light {
background: white;
color: #0b2559;
}

.button-light:hover {
background: #e0b94f;
}

/* ================= QUICK FEATURES ================= */

.quick-features {
background: #0b2559;
color: white;
}

.quick-grid {
display: grid;
grid-template-columns: repeat(4, 1fr);
}

.quick-card {
display: flex;
align-items: center;
gap: 14px;
padding: 28px 18px;
border-right: 1px solid rgba(255,255,255,0.15);
}

.quick-card > span {
font-size: 30px;
}

.quick-card strong,
.quick-card small {
display: block;
}

.quick-card strong {
font-size: 14px;
}

.quick-card small {
color: #cbd4e4;
font-size: 12px;
}

/* ================= SECTIONS ================= */

.section {
padding: 100px 0;
}

.light-section {
background: #f6f8fc;
}

.section-heading {
max-width: 700px;
text-align: center;
margin: 0 auto 55px;
}

.section-heading h2,
.about-content h2 {
color: #0b2559;
font-size: 40px;
line-height: 1.2;
margin-bottom: 15px;
}

.section-heading p:last-child {
color: #697386;
}

/* ================= ABOUT ================= */

.two-column {
display: grid;
grid-template-columns: 1fr 1fr;
gap: 70px;
align-items: center;
}

.school-image {
min-height: 420px;
}

.placeholder-image {
min-height: 420px;
border-radius: 10px;

```
background:
    linear-gradient(
        135deg,
        #0b2559,
        #456aa0
    );

display: flex;
flex-direction: column;
justify-content: center;
align-items: center;

color: white;
text-align: center;
```

}

.placeholder-image span {
font-size: 80px;
margin-bottom: 15px;
}

.placeholder-image strong {
font-size: 24px;
}

.placeholder-image small {
color: #dce3ef;
margin-top: 5px;
}

.about-content p {
color: #697386;
margin-bottom: 20px;
}

.text-link {
color: #0b2559;
font-weight: bold;
}

/* ================= FEATURE CARDS ================= */

.feature-grid {
display: grid;
grid-template-columns: repeat(4, 1fr);
gap: 20px;
}

.feature-card {
background: white;
padding: 35px 25px;
border: 1px solid #e4e8ef;
border-radius: 8px;
transition: 0.3s;
}

.feature-card:hover {
transform: translateY(-7px);
box-shadow: 0 15px 35px rgba(0,0,0,0.08);
}

.feature-icon {
font-size: 38px;
margin-bottom: 18px;
}

.feature-card h3 {
color: #0b2559;
margin-bottom: 10px;
}

.feature-card p {
color: #697386;
font-size: 14px;
}

/* ================= ACADEMICS ================= */

.academic-grid {
display: grid;
grid-template-columns: repeat(3, 1fr);
gap: 25px;
}

.academic-card {
padding: 35px;
border: 1px solid #e4e8ef;
border-radius: 8px;
transition: 0.3s;
}

.academic-card:hover {
border-color: #c79b32;
transform: translateY(-5px);
}

.card-number {
color: #c79b32;
font-weight: bold;
}

.academic-card h3 {
color: #0b2559;
font-size: 23px;
margin: 18px 0 12px;
}

.academic-card p {
color: #697386;
}

/* ================= ADMISSION CTA ================= */

.admission-cta {
padding: 80px 0;
background: #0b2559;
color: white;
}

.admission-content {
display: flex;
justify-content: space-between;
align-items: center;
gap: 40px;
}

.light-label {
color: #e0b94f;
}

.admission-content h2 {
max-width: 750px;
font-size: 40px;
line-height: 1.2;
margin-bottom: 15px;
}

.admission-content p {
max-width: 700px;
color: #d7deeb;
}

/* ================= FORMS ================= */

.form-container {
max-width: 1000px;
}

.school-form {
background: white;
padding: 40px;
border-radius: 10px;
box-shadow: 0 10px 35px rgba(0,0,0,0.06);
}

.form-row {
display: grid;
grid-template-columns: 1fr 1fr;
gap: 20px;
}

.form-group {
margin-bottom: 20px;
}

.form-group label {
display: block;
color: #0b2559;
font-size: 14px;
font-weight: bold;
margin-bottom: 8px;
}

.form-group input,
.form-group select,
.form-group textarea {
width: 100%;
padding: 14px;
border: 1px solid #dce1e9;
border-radius: 5px;
background: white;
color: #172033;
outline: none;
font-size: 14px;
}

.form-group input:focus,
.form-group select:focus,
.form-group textarea:focus {
border-color: #0b2559;
}

/* ================= GALLERY ================= */

.gallery-grid {
display: grid;
grid-template-columns: repeat(3, 1fr);
gap: 20px;
}

.gallery-placeholder {
min-height: 230px;
border-radius: 8px;

```
background:
    linear-gradient(
        135deg,
        #0b2559,
        #456aa0
    );

display: flex;
flex-direction: column;
justify-content: center;
align-items: center;

color: white;
```

}

.gallery-placeholder span {
font-size: 60px;
margin-bottom: 10px;
}

/* ================= NEWS ================= */

.news-grid {
display: grid;
grid-template-columns: repeat(3, 1fr);
gap: 25px;
}

.news-card {
background: white;
padding: 30px;
border-radius: 8px;
border: 1px solid #e4e8ef;
}

.news-icon {
font-size: 50px;
margin-bottom: 20px;
}

.news-category {
color: #c79b32;
font-size: 11px;
font-weight: bold;
letter-spacing: 1px;
}

.news-card h3 {
color: #0b2559;
margin: 10px 0;
}

.news-card p {
color: #697386;
font-size: 14px;
}

/* ================= CONTACT ================= */

.contact-grid {
display: grid;
grid-template-columns: 0.8fr 1.2fr;
gap: 60px;
align-items: start;
}

.contact-item {
display: flex;
gap: 18px;
margin-bottom: 35px;
}

.contact-item > span {
width: 50px;
height: 50px;
flex-shrink: 0;

```
display: flex;
justify-content: center;
align-items: center;

border-radius: 50%;
background: #0b2559;
font-size: 22px;
```

}

.contact-item h3 {
color: #0b2559;
}

.contact-item p {
color: #697386;
}

/* ================= FOOTER ================= */

.footer {
padding-top: 70px;
background: #071936;
color: white;
}

.footer-grid {
display: grid;
grid-template-columns: 2fr 1fr 1fr 1fr;
gap: 50px;
padding-bottom: 50px;
}

.footer-brand {
font-size: 20px;
font-weight: bold;
margin-bottom: 15px;
}

.footer-grid > div > p {
color: #aeb9cb;
font-size: 14px;
margin-bottom: 8px;
}

.footer-grid h3 {
color: #e0b94f;
margin-bottom: 15px;
}

.footer-grid a {
display: block;
color: #aeb9cb;
font-size: 14px;
margin-bottom: 9px;
}

.footer-grid a:hover {
color: white;
}

.footer-bottom {
border-top: 1px solid rgba(255,255,255,0.1);
text-align: center;
color: #8d99ad;
font-size: 13px;
padding: 25px;
}

/* ================= TABLET ================= */

@media (max-width: 900px) {

```
.navbar {
    position: absolute;
    top: 80px;
    left: 0;
    width: 100%;

    display: none;
    flex-direction: column;
    align-items: stretch;

    padding: 20px;
    background: white;

    box-shadow: 0 10px 25px rgba(0,0,0,0.1);
}

.navbar.active {
    display: flex;
}

.navbar a {
    padding: 10px;
}

.menu-button {
    display: block;
}

.quick-grid {
    grid-template-columns: repeat(2, 1fr);
}

.feature-grid {
    grid-template-columns: repeat(2, 1fr);
}

.two-column {
    grid-template-columns: 1fr;
}

.academic-grid {
    grid-template-columns: 1fr;
}

.gallery-grid {
    grid-template-columns: repeat(2, 1fr);
}

.news-grid {
    grid-template-columns: 1fr;
}

.contact-grid {
    grid-template-columns: 1fr;
}

.footer-grid {
    grid-template-columns: repeat(2, 1fr);
}

.admission-content {
    flex-direction: column;
    align-items: flex-start;
}
```

}

/* ================= PHONE ================= */

@media (max-width: 600px) {

```
.container {
    width: 92%;
}

.hero {
    min-height: 600px;
}

.hero h1 {
    font-size: 43px;
}

.hero-description {
    font-size: 16px;
}

.section {
    padding: 70px 0;
}

.section-heading h2,
.about-content h2,
.admission-content h2 {
    font-size: 30px;
}

.quick-grid,
.feature-grid,
.gallery-grid,
.footer-grid,
.form-row {
    grid-template-columns: 1fr;
}

.quick-card {
    border-right: none;
    border-bottom: 1px solid rgba(255,255,255,0.15);
}

.school-form {
    padding: 25px;
}

.hero-buttons {
    flex-direction: column;
    align-items: flex-start;
}
```

}
